{
    "name": "api",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file=.env src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "migrate": "tsx --env-file=.env src/migrate.ts",
        "seed": "tsx --env-file=.env src/seed.ts",
        "test": "DATABASE_URL=postgres://flags:flags@localhost:5432/flags_test JWT_SECRET=test-secret vitest run",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.23.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.3",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "supertest": "^7.3.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    }
}
